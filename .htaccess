# CONFIG-VERSION: 5 (2026-10-03)
# Bump talet over ved kvar endring, slik at filinnhaldet garantert skil seg frå
# det som alt ligg på server (same konvensjon som PolitiKartet).
#
# Stadfest kva som faktisk er live med:
#   curl -s -I https://littavalt.no/vind/index.html | grep -i content-security-policy

# ============================================================ Tryggingsheader
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"

    # CSP.
    #
    # script-src har INGEN 'unsafe-inline' — appen har ingen inline <script>
    # og ingen onclick=-attributt. All interaksjon går via data-action og
    # delegerte lyttarar. Held det slik.
    #
    # style-src treng 'unsafe-inline' fordi Leaflet set style-attributt direkte
    # på kartelementa når det posisjonerer fliser og markørar.
    #
    # connect-src: vårt eige opphav + dei to CDN-ane. Alle eksterne API-kall
    # (NVE, Kartverket WPS) går gjennom PHP-backenden — nettlesaren snakkar
    # aldri direkte med dei. Appen sjølv gjer ingen fetch() mot CDN-ane
    # (biblioteka kjem inn via script-src/style-src), men utviklarverktøya i
    # nettlesaren hentar source maps (leaflet.js.map o.l.) derifrå, og utan
    # dei to vertane her fyller det konsollen med CSP-feil. Versjon 4 prøvde
    # berre 'self' og fekk nettopp det. Rein-lese-CDN-ar, så dei opnar ingen
    # veg ut for data. img-src må derimot tillate flis-tenarane.
    #
    # IKKJE FJERN server.arcgisonline.com FRÅ img-src. Han ser ut som eit
    # reint Leaflet-behov (flybilete-bakgrunnslaget i 2D-kartet), men
    # 3D-panoramaet hentar dei SAME flisane som <img crossOrigin="anonymous">
    # og teiknar dei til eit lerret som vert tekstur på terrengmeshen
    # (js/utils/SatelliteTexture.js, CLAUDE.md §17). At det er ei
    # biletehenting og ikkje ein fetch() er nettopp difor: fetch() ville falle
    # under connect-src og kravt anten ei CSP-utviding eller ein PHP-proxy.
    # Blir direktivet stramma inn, feilar panoramaet STILLE — det fell tilbake
    # til prosedyrefarge i staden for å gi ein feil.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://unpkg.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://cache.kartverket.no https://server.arcgisonline.com https://services.arcgisonline.com https://unpkg.com; connect-src 'self' https://unpkg.com https://cdnjs.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
</IfModule>

# ============================================================ Tilgangskontroll

# Blokker alle punktfiler (.env, .git, ...)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Blokker sensitive filtypar (dokumentasjon, logger, backup, konfig)
<FilesMatch "(^#.*#|\.(bak|config|dist|ini|lock|log|md|sh|sql|sw[op]|ffs_db|mjs)|~)$">
    Require all denied
</FilesMatch>

# Ingen fillister
Options -Indexes

# Alt under cache/ er internt arbeidsminne for PHP (høgdeprofilar, rate
# limiting, layout-estimat, versjonssjekk-cache, låsefiler) — bortsett frå
# dei to filene frontend hentar direkte.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^cache/(?!turbines\.json$|areas\.json$) - [F,L]
</IfModule>

# tools/ er lokale dev-verktøy (Node), skal aldri køyre eller lesast frå web.
<IfModule mod_rewrite.c>
    RewriteRule ^tools/ - [F,L]
</IfModule>

# ============================================================ Yting

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png              "access plus 1 month"
    ExpiresByType image/jpeg             "access plus 1 month"
    ExpiresByType image/svg+xml          "access plus 1 month"
    # Turbin-cachen vert oppdatert dagleg av cron — kort levetid.
    ExpiresByType application/json       "access plus 1 hour"
</IfModule>

# HTML, CSS OG JS SKAL ALLTID REVALIDERAST.
#
# Appen har ingen build-steg, så filnamna ber ingen versjon: js/app.js heiter
# det same før og etter ein deploy, og ES-modulane importerer kvarandre med
# relative stiar som ingen ?v=-parameter når. «no-cache» tyder ikkje «ikkje
# cache», men «spør fyrst»: nettlesaren held på fila og får eit tomt 304-svar
# til ho faktisk er endra.
#
# Til og med versjon 3 hadde CSS «access plus 1 week» — den som hadde vore
# innom fekk dermed ny HTML med GAMMALT stilark i opptil sju dagar etter ein
# deploy. JS hadde same regel på papiret, men han trefte aldri (sjå MIME-
# merknaden under), så JS gjekk ut heilt utan cache-header.
<FilesMatch "\.(html|css|js)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

# MIME-TYPEN FOR JS ER text/javascript, IKKJE application/javascript.
#
# Apache serverer .js som text/javascript (RFC 9239). Ein regel som berre
# nemner application/javascript treffer difor ingenting — verifisert mot den
# live sida: alle 26 modulane gjekk ut ukomprimerte, 566 KB i staden for
# 188 KB. Begge typane står her, så regelen held uansett kva mime.types
# serveren har.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/json application/javascript text/javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
